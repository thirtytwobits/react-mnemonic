{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://thirtytwobits.github.io/react-mnemonic/benchmarks/ai-friendliness/human-review.schema.json",
    "title": "AI Friendliness Human Review",
    "type": "object",
    "required": ["reviewer", "reviewedAt", "scenarios"],
    "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "scenarios": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "persistenceAppropriateness",
                    "semanticNuanceCorrectness",
                    "unnecessaryUserIntervention",
                    "criticalSemanticMiss",
                    "notes"
                ],
                "properties": {
                    "persistenceAppropriateness": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "semanticNuanceCorrectness": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "unnecessaryUserIntervention": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "criticalSemanticMiss": { "type": "boolean" },
                    "notes": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
