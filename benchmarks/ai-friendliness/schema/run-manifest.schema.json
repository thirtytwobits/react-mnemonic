{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://thirtytwobits.github.io/react-mnemonic/benchmarks/ai-friendliness/run-manifest.schema.json",
    "title": "AI Friendliness Run Manifest",
    "type": "object",
    "required": ["runId", "label", "runType", "library", "contextProfile", "model", "humanReviewPath", "scenarios"],
    "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "runType": { "enum": ["validation", "evaluation"] },
        "library": { "type": "string", "minLength": 1 },
        "contextProfile": { "type": "string", "minLength": 1 },
        "humanReviewPath": { "type": "string", "minLength": 1 },
        "model": {
            "type": "object",
            "required": ["provider", "modelId", "runDate", "promptPackVersion"],
            "properties": {
                "provider": { "type": "string", "minLength": 1 },
                "modelId": { "type": "string", "minLength": 1 },
                "runDate": { "type": "string", "minLength": 1 },
                "promptPackVersion": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
        },
        "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["scenarioId", "transcriptPath", "submissionDir", "followUpPrompts", "firstAttempt"],
                "properties": {
                    "scenarioId": { "type": "string", "minLength": 1 },
                    "transcriptPath": { "type": "string", "minLength": 1 },
                    "submissionDir": { "type": "string", "minLength": 1 },
                    "followUpPrompts": { "type": "integer", "minimum": 0 },
                    "reviewerNotesPath": { "type": "string" },
                    "firstAttempt": {
                        "type": "object",
                        "required": ["compiled", "tested"],
                        "properties": {
                            "compiled": { "type": "boolean" },
                            "tested": { "type": "boolean" }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
