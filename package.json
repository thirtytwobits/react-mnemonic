{
    "name": "react-mnemonic",
    "version": "1.3.0",
    "description": "Persistent, type-safe state management for React",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": {
                "import": "./dist/index.d.ts",
                "require": "./dist/index.d.cts"
            },
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./core": {
            "types": {
                "import": "./dist/core.d.ts",
                "require": "./dist/core.d.cts"
            },
            "import": "./dist/core.js",
            "require": "./dist/core.cjs",
            "default": "./dist/core.js"
        },
        "./schema": {
            "types": {
                "import": "./dist/schema.d.ts",
                "require": "./dist/schema.d.cts"
            },
            "import": "./dist/schema.js",
            "require": "./dist/schema.cjs",
            "default": "./dist/schema.js"
        },
        "./optional": {
            "types": {
                "import": "./dist/optional.d.ts",
                "require": "./dist/optional.d.cts"
            },
            "import": "./dist/optional.js",
            "require": "./dist/optional.cjs",
            "default": "./dist/optional.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:consumers": "node ./scripts/run-consumer-fixtures.mjs",
        "test:coverage": "vitest run --coverage",
        "test:optional-bundle": "node ./scripts/check-optional-bundle.mjs",
        "test:watch": "vitest",
        "ai:check": "node ./website/scripts/generate-ai-assets.mjs --check && node ./scripts/generate-agent-instructions.mjs --check",
        "lint": "tsc -p tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docs:ai": "node ./website/scripts/generate-ai-assets.mjs && node ./scripts/generate-agent-instructions.mjs",
        "docs:version": "npm --prefix website run typedoc && npm run docs:ai && npm --prefix website run docusaurus -- docs:version",
        "release:prepare": "node ./scripts/prepare-release.mjs",
        "docs": "typedoc",
        "docs:watch": "typedoc --watch",
        "docs:site": "npm --prefix website run build",
        "docs:site:start": "npm --prefix website start"
    },
    "keywords": [
        "react",
        "react-hooks",
        "persistent-state",
        "localstorage",
        "state-management",
        "typescript",
        "codec",
        "cross-tab"
    ],
    "author": "Scott Dixon",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thirtytwobits/react-mnemonic.git"
    },
    "homepage": "https://thirtytwobits.github.io/react-mnemonic/",
    "bugs": {
        "url": "https://github.com/thirtytwobits/react-mnemonic/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "fast-check": "^4.5.3",
        "jsdom": "^25.0.1",
        "prettier": "^3.6.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tsup": "^8.3.5",
        "typedoc": "^0.28.17",
        "typescript": "^5.7.3",
        "vitest": "^3.2.4"
    },
    "sideEffects": false
}
